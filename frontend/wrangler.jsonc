// Tells Cloudflare how to publish the site (read by "wrangler", Cloudflare's deploy tool).
{
  // The site's name on Cloudflare. It becomes part of the temporary address
  // (for example jcmuhire-site.<account>.workers.dev). Lowercase letters, numbers, dashes.
  "name": "jcmuhire-site",

  // The date this config was written for. Cloudflare uses it to keep behaviour stable.
  "compatibility_date": "2026-10-13",

  "assets": {
    // The folder that "npm run build" creates: the finished website files.
    "directory": "./dist",

    // Each page has its own ready-made file (speaking.html, my-story.html...), written at build
    // time by tools/prerender-heads.mjs, so /speaking is served from speaking.html and refreshing
    // any page works. Any other address gets 404.html with a real "404 not found" status, so
    // search engines never treat a wrong address as a page (QA D-07).
    // A NEW PAGE needs an entry in src/content/pageMeta.js, or it will answer "not found";
    // the build checks this and fails if one is missing.
    "not_found_handling": "404-page"
  }
}
